Vec2 a = { .x = 3, .y = 4 };
myint mx = 42;

int counter = 0;
int sum = 0;
enum Mood { HAPPY, SAD, ANGRY };

int add(int a, int b) {
	return a + b;
}

class FATHER() {
	@return
	int Age() {
		return 55;
	}
}

class CHILD(FATHER) {
	void head(gcChar who) {
		gcChar name = who;
	}
	void talk() {
		print("child talks!\n");
	}
}

void Ready() {
	PrintF("EDSF %d\n", EDSF);
	PrintF("ABCD %f\n", ABCD);
	PrintF("TEXT %c\n", TEXT);
	PrintF("TEXT2 %s\n", TEXT2);
	PrintF("game %s\n", game);
	PrintF("alphabet %s\n", alphabet);
	PrintF("RED %d GREEN %d BLUE %d\n", RED, GREEN, BLUE);
	PrintF("p1.name %s p1.health %d p1.speed %f\n", p1.name, p1.health, p1.speed);
	PrintF("a.x %f a.y %f\n", a.x, a.y);
	PrintF("mx %d\n", mx);
	PrintF("mix[1] %s mix[3] %f\n", mix[1], mix[3]);
	PrintF("player.name %s player.scale %d\n", player.name, player.scale);

	PrintF("int8:        %d\n", number0);
	PrintF("uint8:             %u\n", unumber1);
	PrintF("float32:       %f\n", fnumber1);

	# kontrol akisi
	if (EDSF == 31) {
		PrintF("if: EDSF == 31 OK\n");
	} else {
		PrintF("if: EDSF != 31 BAD\n");
	}

	if (EDSF > 50) {
		PrintF("if/else-if: > 50\n");
	} else if (EDSF > 20) {
		PrintF("if/else-if: > 20 (EDSF)\n");
	} elif (EDSF > 10) {
		PrintF("elif calisti\n");
	} else {
		PrintF("else calisti\n");
	}

	for (int i = 0; i < 3; i++) {
		sum += i;
	}
	PrintF("for: sum = %d\n", sum);

	while (counter < 3) {
		counter++;
	}
	PrintF("while: counter = %d\n", counter);

	int m = HAPPY;
	switch (m) {
		case HAPPY:
			PrintF("switch: HAPPY\n");
			break;
		case SAD:
			PrintF("switch: SAD\n");
			break;
		default:
			PrintF("switch: default\n");
			break;
	}

	# kullanici fonksiyonu
	int r = add(19, 23);
	PrintF("func: add(19, 23) = %d\n", r);

	# class
	FATHER ThisFather = FATHER;
	CHILD  ThisChild  = CHILD("ali");

	PrintF("class: ThisFather.Age = %d\n", ThisFather.Age);
	ThisChild.talk();

	# ternary / bitwise / sizeof / operator typedef
	int pick = (EDSF > 20) ? 100 : 0;
	PrintF("ternary: pick = %d\n", pick);

	int band = 5 & 3;
	int bor  = 5 | 3;
	int bxor = 5 ^ 3;
	int bsh  = 1 << 4;
	PrintF("bitwise: 5&3=%d 5|3=%d 5^3=%d 1<<4=%d\n", band, bor, bxor, bsh);

	PrintF("sizeof: int=%d double=%d char=%d\n", sizeof(int), sizeof(double), sizeof(char));

	if (5 & 1) {
		PrintF("bitwise cond: 5 & 1 = true\n");
	} else {
		PrintF("bitwise cond: 5 & 1 = false\n");
	}

	typedef == equals;
	typedef != notEquals;
	typedef && and;
	typedef || or;
	typedef ! not;

	if (10 equals 10 and 1 or 0) {
		PrintF("op-typedef: equals/and/or OK\n");
	}
	if (not (1 equals 2)) {
		PrintF("op-typedef: not OK\n");
	}
}

