# GCL Demo - gcl_language.md ozelliklerini gosterir
# Bu dosya preprocessor (#), GCL 101 top-level cagrilar ve
# fonksiyon cagrilarini test eder.

#define MAX_PLAYER 10
#define TITLE "GnuChan GCL Demo"
#define DEBUG_MODE 1

@extern FPSController

#warning "Bu bir sari uyari: ", TITLE
#debug   "Bu bir mavi debug mesaji"

#if windows
#debug "Windows platformu algilandi"
#elif linux
#debug "Linux platformu algilandi"
#else
#debug "Bilinmeyen platform"
#endif

#ifdef DEBUG_MODE
    #warning "Debug modu aktif"
#endif

#extern "raylib.dll"
#register void InitWindow(int width, int height, const char *title);
#register void CloseWindow(void);

int global_variable = 10;

void print_this_global() {
    global gx;

    printf("Global GX: %d \n", gx);
}

void print_this_local() {
    inline gx;

    int gx = 31;

    printf("local GX: %d \n", gx);
}

int add_numbers(int a, int b) {
    return a + b;
}

int gx = 10;

void Ready() {
    #// GCL 101 ornekleri
    print_this_global();
    print_this_local();

    int result = add_numbers(5, 7);
    printf("add_numbers(5, 7) = %d \n", result);

    #ifdef MAX_PLAYER
    printf("MAX_PLAYER = %d \n", MAX_PLAYER);
    #endif

    printf("TITLE = %s \n", TITLE);
}

void Update(float delta) {
    #// her frame cagrilir
    if (Input.IsDown("e")) {
        printf("E tusuna basilidi \n");
    }
}

void UpdatePhysics(float delta) {
    #// fizik frame'inde cagrilir
}
